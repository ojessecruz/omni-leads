APP_NAME="Omni Leads"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:9030

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=omni_leads
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=1830

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@omni-leads.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sail — portas não padrão (projetos paralelos)
APP_PORT=9030
VITE_PORT=5190
FORWARD_DB_PORT=54320
FORWARD_REDIS_PORT=6390
FORWARD_MAILPIT_PORT=1040
FORWARD_MAILPIT_DASHBOARD_PORT=8040

# Lead sources
GOOGLE_PLACES_ENABLED=true
GOOGLE_PLACES_KEY=
GOOGLE_PLACES_MAX_PAGES=3
GOOGLE_PLACES_RPS=10

# Enriquecimento
ENRICHMENT_TTL_DAYS=30
SITE_SCRAPE_ENABLED=true
HUNTER_ENABLED=false
HUNTER_KEY=
EVOLUTION_ENABLED=false
EVOLUTION_BASE_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
LEAD_QUALIFIED_THRESHOLD=60

# Fontes adicionais (Fase 3)
APOLLO_ENABLED=false
APOLLO_KEY=
CNPJ_BR_ENABLED=false
