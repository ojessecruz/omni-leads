APP_NAME="Omni Leads"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:9030
APP_DISPLAY_TIMEZONE=America/Sao_Paulo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=omni_leads
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=1830

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@omni-leads.test"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare R2 is the default disk (production sets FILESYSTEM_DISK=r2 or leaves it unset); local dev uses public.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Format: https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_URL=
R2_ROOT=omnileads

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sail — portas não padrão (projetos paralelos)
APP_PORT=9030
VITE_PORT=5190
FORWARD_DB_PORT=54320
FORWARD_REDIS_PORT=6390
FORWARD_MAILPIT_PORT=1040
FORWARD_MAILPIT_DASHBOARD_PORT=8040

# Lead sources (API keys are BYOK: each user adds them in Settings > Integrations)
GOOGLE_PLACES_MAX_PAGES=3
GOOGLE_PLACES_RPS=10

# Enriquecimento
ENRICHMENT_TTL_DAYS=30
SITE_SCRAPE_ENABLED=true
# Servidor Evolution do Omni Leads (opcional): usuários sem servidor próprio pareiam o celular nele
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
LEAD_QUALIFIED_THRESHOLD=60

# Fontes adicionais (Fase 3)
CNPJ_BR_ENABLED=false

# ICP map tiles (default: OpenStreetMap, no key). See config/services.php.
# MAP_TILES_URL=
# MAP_TILES_ATTRIBUTION=
# MAP_TILES_DARK_FILTER=true

# Emails allowed to open /horizon outside local (comma separated)
HORIZON_ADMINS=

# Public sign-up (off: only existing accounts can log in)
# Comma-separated emails that can invite users while sign-up is closed
ADMIN_EMAILS=
REGISTRATION_ENABLED=false
PASSKEYS_ENABLED=false

# Reverb (WebSocket for the WhatsApp inbox). BROADCAST_CONNECTION=reverb turns it on.
# REVERB_HOST/PORT/SCHEME: how the app reaches the Reverb server (internal address in production).
# REVERB_PUBLIC_*: where browsers connect (the public WebSocket domain); default to the above.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=
REVERB_PUBLIC_PORT=
REVERB_PUBLIC_SCHEME=
